# Local/synthetic development only. Copy selected values into your local
# runtime environment; do not put customer workbooks or credentials here.

# Google ledger inputs are local exported snapshots. Both paths must point
# outside the source tree to operator-managed files; setting them does not
# grant Google access or enable a live sync by itself.
# WEBLEDGER_GOOGLE_LEDGER_SNAPSHOT=./runtime/google-ledger-snapshot.json
# WEBLEDGER_GOOGLE_LEDGER_ROWS=./runtime/google-ledger-rows.json

# Optional demo data is synthetic only and must never point to a customer
# workbook or production snapshot.
# WEBLEDGER_DEMO_SNAPSHOT=./runtime/synthetic-demo-snapshot.json

# Provider credentials are stored separately by the local provider secret
# store. Point this variable at a private runtime file; never put the secret
# values themselves in an environment file, source tree, or test fixture.
# WEBLEDGER_PROVIDER_SECRETS=./runtime/provider-secrets.json

# Provider fallback is an owner-managed setting in the provider configuration
# store. Do not configure provider API credentials in this file.
