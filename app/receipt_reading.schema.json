{
  "type": "object",
  "additionalProperties": false,
  "required": ["header_text", "header_confidence", "receipts", "lesson"],
  "properties": {
    "header_text": {"type": ["string", "null"], "maxLength": 200},
    "header_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "receipts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["box", "merchant", "date", "amount", "currency", "payment", "card_last4",
                     "confidence", "uncertain_fields", "note"],
        "properties": {
          "box": {"type": ["array", "null"], "items": {"type": "number", "minimum": 0, "maximum": 1},
                  "minItems": 4, "maxItems": 4},
          "merchant": {"type": ["string", "null"], "maxLength": 120},
          "date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "amount": {"type": ["integer", "null"], "minimum": 1},
          "currency": {"type": ["string", "null"], "pattern": "^[A-Z]{3}$"},
          "payment": {"enum": ["cash", "card", "other", null]},
          "card_last4": {"type": ["string", "null"], "pattern": "^\\d{4}$"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "uncertain_fields": {"type": "array", "items": {"enum": ["box", "merchant", "date", "amount", "currency",
                                                                 "payment", "card_last4"]}},
          "note": {"type": ["string", "null"], "maxLength": 240}
        }
      }
    },
    "lesson": {"type": ["string", "null"], "maxLength": 200}
  }
}
