{
  "schema_version": 1,
  "data_root_env": "WEBLEDGER_DATA_ROOT",
  "secret_handling": {
    "model": "runtime_file_arguments",
    "entrypoint": "tools/launch_web_ledger.py",
    "arguments": ["--oauth-file", "--session-secret-file"],
    "preflight_reads_secret_values": false
  },
  "entrypoints": [
    {"path": "tools/verify_lightweight_runtime.py", "guard": "read_only",
     "cli": {"default": "legacy_live_read_only", "options": ["--live", "--preflight"]},
     "canonical": true,
     "aliases": ["tools/run_lightweight_verification.ps1", "tools/run_lightweight_finalize.ps1"],
     "callers": ["tools/run_lightweight_verification.ps1", "tools/run_lightweight_finalize.ps1"]},
    {"path": "tools/launch_web_ledger.py", "guard": "protected_write",
     "required_options": ["--checkout", "--data-root", "--oauth-file", "--session-secret-file"]},
    {"path": "tools/run_lightweight_deployment.ps1", "guard": "maintenance",
     "aliases": []},
    {"path": "tools/deploy_lightweight.py", "guard": "maintenance",
     "authorization_env": "WEBLEDGER_MAINTENANCE=LIGHTWEIGHT"},
    {"path": "tools/deploy_reserve_candidate.py", "guard": "maintenance",
     "authorization_env": "WEBLEDGER_MAINTENANCE=RESERVE_CANDIDATE", "options": ["--rollback"]},
    {"path": "tools/deploy_reserve_navigation.py", "guard": "maintenance",
     "authorization_env": "WEBLEDGER_MAINTENANCE scoped by positional prefix"},
    {"path": "tools/deploy_reserve_trips.py", "guard": "protected_write",
     "authorization_env": "not present in entrypoint; backup/rehearsal checks inside", "options": []},
    {"path": "tools/prepare_cloud_mail_release.py", "guard": "isolated_output",
     "required_option": "--output", "existing_output": "refused"},
    {"path": "tools/sync_runtime_requirements.py", "guard": "maintenance",
     "write_option": "--write", "default": "check_only"}
  ]
}
