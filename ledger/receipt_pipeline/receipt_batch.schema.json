{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.soopgil.example/schemas/receipt-batch.schema.json",
  "title": "Lossless physical receipt batch",
  "type": "object",
  "required": ["batch_id", "currency", "conversion_policy", "images", "receipts"],
  "properties": {
    "batch_id": {"type": "string", "minLength": 1},
    "currency": {"const": "JPY"},
    "conversion_policy": {
      "type": "object",
      "required": ["type", "krw_per_jpy", "confirmed_by_user_on"],
      "properties": {
        "type": {"const": "fixed_convenience_rate"},
        "krw_per_jpy": {"const": 10},
        "confirmed_by_user_on": {"type": "string", "format": "date"}
      }
    },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["image_id", "file_name", "expected_physical_receipts", "header"],
        "properties": {
          "image_id": {"type": "string", "minLength": 1},
          "file_name": {"type": "string", "minLength": 1},
          "expected_physical_receipts": {"type": "integer", "minimum": 1},
          "header": {
            "type": "object",
            "required": ["raw", "trip_candidate", "confidence"],
            "properties": {
              "raw": {"type": "string"},
              "period_start": {"type": ["string", "null"], "format": "date"},
              "period_end": {"type": ["string", "null"], "format": "date"},
              "region": {"type": ["string", "null"]},
              "trip_candidate": {"type": ["string", "null"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        }
      }
    },
    "receipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "physical_id", "image_id", "position", "date", "merchant",
          "amount_jpy", "payment_method", "trip_assignment"
        ],
        "properties": {
          "physical_id": {"type": "string", "minLength": 1},
          "image_id": {"type": "string", "minLength": 1},
          "position": {"type": "string", "minLength": 1},
          "date": {"type": ["string", "null"], "format": "date"},
          "merchant": {
            "type": "object",
            "required": ["value", "status", "confidence"],
            "properties": {
              "value": {"type": ["string", "null"]},
              "status": {"enum": ["confirmed", "estimated", "unreadable"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "amount_jpy": {
            "type": "object",
            "required": ["value", "status", "confidence"],
            "properties": {
              "value": {"type": ["integer", "null"], "minimum": 0},
              "status": {"enum": ["confirmed", "estimated", "unreadable"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1}
            }
          },
          "payment_method": {
            "type": "object",
            "required": ["value", "status", "confidence"],
            "properties": {
              "value": {"enum": ["cash", "card", "unknown"]},
              "status": {"enum": ["confirmed", "estimated", "unreadable"]},
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "detail": {"type": ["string", "null"]}
            }
          },
          "classification": {
            "type": "object",
            "required": ["target", "account", "status", "amount_krw"],
            "properties": {
              "target": {"type": "string", "minLength": 1},
              "account": {"type": "string", "minLength": 1},
              "status": {"enum": ["user_confirmed", "auto_proposed", "review_required"]},
              "amount_krw": {"type": "integer", "minimum": 0}
            }
          },
          "trip_assignment": {
            "type": "object",
            "required": [
              "trip_candidate", "header_match", "date_region_match",
              "status", "confidence"
            ],
            "properties": {
              "trip_candidate": {"type": ["string", "null"]},
              "header_match": {"type": ["boolean", "null"]},
              "date_region_match": {"type": ["boolean", "null"]},
              "status": {
                "enum": ["auto_assigned", "manual_confirmed", "review_required"]
              },
              "confidence": {"type": "number", "minimum": 0, "maximum": 1},
              "note": {"type": "string"}
            }
          },
          "notes": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
