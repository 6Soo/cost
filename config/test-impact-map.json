    {
      "name": "test-selection",
      "paths": ["tools/select_targeted_tests.py", "config/test-impact-map.json",
                "webapp/tests/test_targeted_test_selector.py"],
      "tests": ["webapp/tests/test_targeted_test_selector.py"]
    }
  ]
