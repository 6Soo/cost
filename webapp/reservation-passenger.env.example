# Optional, owner-only passenger candidate review. Copy values into a protected
# service environment; do not put real credentials or customer data in this file.
WEBLEDGER_FLIGHT_PASSENGER_MATCHING=1
WEBLEDGER_FLIGHT_PASSENGER_DB=C:\AX\cost-dev-data\flight-passenger.sqlite
RESERVATION_INTERNAL_BASE_URL=https://reservation-preview.example.invalid
RESERVATION_INTERNAL_API_TOKEN_FILE=C:\AX\cost-dev-secrets\reservation-internal-token.txt
# Instead of TOKEN_FILE, a protected service environment may set
# RESERVATION_INTERNAL_API_TOKEN to the same approved value as reservation's
# COST_INTERNAL_API_TOKEN (preferred dedicated COST credential) or existing
# INTERNAL_API_TOKEN. Never write the value here.
# The two Reservation token names are distinct credentials: do not confuse
# either with TURSO_READONLY_AUTH_TOKEN, which is for the Reservation DB only.
# Replace the example URL and file path only in a separately approved environment.
# Reservation service additionally needs TURSO_READONLY_AUTH_TOKEN in its own
# protected environment. This COST example does not contain that credential.
