      "tests": ["webapp/tests/test_card_flow.py", "webapp/tests/test_card_flow_browser.py"]
    },
    {
      "name": "ota-reconciliation",
      "paths": ["app/ota_*.py", "webapp/ota_*.py"],
      "tests": ["tests/card_pipeline/test_ota_payments.py", "webapp/tests/test_ota_payment_review.py", "webapp/tests/test_ota_payment_review_browser.py"]
    },
    {
      "name": "passenger-linking",
      "paths": ["app/flight_passenger_*.py", "app/reservation_authority.py", "webapp/flight_passenger_page.py"],
      "tests": ["webapp/tests/test_flight_passenger_page.py"]
    },
    {
      "name": "card-import",
      "paths": ["app/import_card.py", "app/card_*.py", "webapp/card_import*.py"],
      "tests": ["webapp/tests/test_card_import.py", "tests/card_pipeline/test_card_pipeline.py"]
