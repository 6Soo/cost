<?xml version="1.0" encoding="UTF-8"?>
<!-- Example only. Disabled. Import with schtasks /Create /XML only after the operator approves scheduling.
     Replace every *_PLACEHOLDER value with a path outside the repository before any use. -->
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>COST Google authority read-only sync (hourly, KST). Disabled example.</Description>
  </RegistrationInfo>
  <Triggers>
    <CalendarTrigger>
      <Enabled>false</Enabled>
      <StartBoundary>2026-10-12T00:00:00+09:00</StartBoundary>
      <Repetition>
        <Interval>PT1H</Interval>
        <StopAtDurationEnd>false</StopAtDurationEnd>
      </Repetition>
      <ScheduleByDay>
        <DaysInterval>1</DaysInterval>
      </ScheduleByDay>
    </CalendarTrigger>
  </Triggers>
  <Settings>
    <Enabled>false</Enabled>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <ExecutionTimeLimit>PT15M</ExecutionTimeLimit>
    <StartWhenAvailable>true</StartWhenAvailable>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <Command>PYTHON_EXE_PLACEHOLDER</Command>
      <Arguments>tools/google_authority_sync.py --snapshot "SNAPSHOT_PATH_PLACEHOLDER" --rows "ROWS_PATH_PLACEHOLDER"</Arguments>
      <WorkingDirectory>REPO_PATH_PLACEHOLDER</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
